// =============================================================================
// INDIAN HOTEL PMS & CRM - PRISMA SCHEMA
// Normalized, decimal-safe production schema with complete audit & compliance
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum RoomStatus {
  Available
  Clean
  Dirty
  Occupied
  Blocked
  Maintenance
}

enum BookingStatus {
  Inquiry
  Tentative
  Confirmed
  CheckedIn
  CheckedOut
  Cancelled
  NoShow
}

enum PaymentMethod {
  Cash
  UPI
  Card
  Razorpay
  Bank_Transfer
  Other
}

enum PaymentStatus {
  Pending
  Authorized
  Captured
  Failed
  Refunded
  PartiallyRefunded
}

enum MealPlan {
  EP // Room only
  CP // Continental (Breakfast)
  MAP // Modified American (Breakfast + Lunch/Dinner)
  AP // American (All Meals)
}

enum IdentityType {
  Aadhaar
  PAN
  Passport
  VoterID
  DrivingLicense
}

enum GuestType {
  Domestic
  International
  Corporate
}

enum LoyaltyTier {
  Bronze
  Silver
  Gold
}

enum LoyaltyTransactionType {
  Earn
  Redeem
  Expire
  Adjustment
  Reversal
}

/// How long earned points stay valid.
enum LoyaltyExpiryBasis {
  EarnTransactionDate
  CalendarYearEnd
}

enum FolioItemType {
  Room
  Food
  Restaurant
  InRoomDining
  Laundry
  Spa
  Housekeeping
  Banquet
  OtherService
  Discount
}

enum LeadStatus {
  New
  Contacted
  Qualified
  Converted
  Lost
}

enum UserRole {
  SuperAdmin
  Admin
  Manager
  FrontDesk
  Housekeeping
  Accountant
}

// -------------------------------------------------------------
// 1. HOTEL & PROPERTY STRUCTURE
// -------------------------------------------------------------

model Hotel {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  gstin        String
  stateCode    String // 2-digit Indian State code e.g. "27"
  address      String
  city         String
  state        String
  pincode      String
  phone        String
  email        String
  website      String?
  currency     String   @default("INR")
  checkInTime  String   @default("14:00")
  checkOutTime String   @default("11:00")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  floors       Floor[]
  roomTypes    RoomType[]
  rooms        Room[]
  ratePlans    RatePlan[]
  bookings     Booking[]
  folios       Folio[]
  services     Service[]
  auditLogs    AuditLog[]
  leads        CRMLead[]
  users        User[]
  loyaltySettings      LoyaltySetting[]
  loyaltyTierRules     LoyaltyTierRule[]
  loyaltyAccounts      LoyaltyAccount[]

  @@index([gstin])
  @@index([stateCode])
}

model Floor {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  floorNumber Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms       Room[]

  @@unique([hotelId, floorNumber])
  @@index([hotelId])
}

model BedType {
  id        String   @id @default(cuid())
  name      String   @unique // King, Queen, Twin, Single, Sofa Bed
  capacity  Int      @default(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms     Room[]
}

model RoomType {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code        String
  name        String // Standard, Deluxe, Suite, Premium, Family
  description String?
  basePrice   Decimal  @db.Decimal(12, 2)
  baseAdults  Int      @default(2)
  maxAdults   Int      @default(3)
  maxChildren Int      @default(2)
  amenities   String   @default("[]") // JSON string of amenities
  images      String   @default("[]") // JSON array of image URLs
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms       Room[]
  ratePlans   RatePlan[]
  bookings    Booking[]

  @@unique([hotelId, code])
  @@index([hotelId])
}

model Room {
  id         String     @id @default(cuid())
  hotelId    String
  hotel      Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomNumber String
  floorId    String
  floor      Floor      @relation(fields: [floorId], references: [id])
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])
  bedTypeId  String?
  bedType    BedType?   @relation(fields: [bedTypeId], references: [id])
  status     RoomStatus @default(Available)
  isActive   Boolean    @default(true)
  baseRate   Decimal?   @db.Decimal(12, 2)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  bookings   Booking[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status])
  @@index([floorId])
  @@index([roomTypeId])
}

model RatePlan {
  id                 String   @id @default(cuid())
  hotelId            String
  hotel              Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId         String
  roomType           RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  code               String
  name               String
  mealPlan           MealPlan @default(EP)
  baseRate           Decimal  @db.Decimal(12, 2)
  seasonalMultiplier Decimal  @default(1.00) @db.Decimal(4, 2)
  weekendMultiplier  Decimal  @default(1.15) @db.Decimal(4, 2)
  extraAdultRate     Decimal  @default(800.00) @db.Decimal(12, 2)
  extraChildRate     Decimal  @default(400.00) @db.Decimal(12, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bookings           Booking[]

  @@unique([hotelId, roomTypeId, code])
  @@index([hotelId])
  @@index([roomTypeId])
}

// -------------------------------------------------------------
// 2. GUEST & IDENTITY COMPLIANCE
// -------------------------------------------------------------

model Guest {
  id                   String        @id @default(cuid())
  fullName             String
  mobile               String
  email                String?
  address              String?
  city                 String?
  stateCode            String? // Indian State code e.g. "27"
  state                String?
  country              String        @default("India")
  guestType            GuestType     @default(Domestic)
  corporateGstin       String?
  corporateName        String?
  internationalDetails String?       @db.Text // JSON: passport, visa, arrival port, etc.
  notes                String?
  preferences          String?       @db.Text // JSON: dietary, floor preference, etc.
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  identities           GuestIdentity[]
  bookings             Booking[]
  bookingGuests        BookingGuest[]
  folios               Folio[]
  payments             Payment[]
  loyaltyAccount       LoyaltyAccount?
  leads                CRMLead[]

  @@index([mobile])
  @@index([fullName])
  @@index([email])
}

model GuestIdentity {
  id             String       @id @default(cuid())
  guestId        String
  guest          Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  identityType   IdentityType
  idNumber       String
  maskedIdNumber String
  verified       Boolean      @default(false)
  issuedCountry  String       @default("India")
  expiryDate     DateTime?
  documentUrl    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([guestId, identityType, idNumber])
  @@index([guestId])
}

// -------------------------------------------------------------
// 3. BOOKING, RESERVATIONS & OCCUPANCY
// -------------------------------------------------------------

model Booking {
  id             String        @id @default(cuid())
  bookingNumber  String        @unique // e.g. BKG-2026-0001
  hotelId        String
  hotel          Hotel         @relation(fields: [hotelId], references: [id])
  primaryGuestId String
  primaryGuest   Guest         @relation(fields: [primaryGuestId], references: [id])
  roomId         String?
  room           Room?         @relation(fields: [roomId], references: [id])
  roomTypeId     String
  roomType       RoomType      @relation(fields: [roomTypeId], references: [id])
  ratePlanId     String
  ratePlan       RatePlan      @relation(fields: [ratePlanId], references: [id])
  checkInDate    DateTime
  checkOutDate   DateTime
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  adults         Int           @default(1)
  children       Int           @default(0)
  mealPlan       MealPlan      @default(EP)
  status         BookingStatus @default(Confirmed)
  bookingSource  String        @default("Direct") // Direct, OTA, Corporate, WalkIn
  specialRequests String?
  totalNights    Int           @default(1)

  // Decimal safe financial breakdown
  roomCharges    Decimal       @default(0.00) @db.Decimal(12, 2)
  extraCharges   Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  grandTotal     Decimal       @default(0.00) @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  balanceAmount  Decimal       @default(0.00) @db.Decimal(12, 2)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bookingGuests  BookingGuest[]
  folio          Folio?
  reservations   Reservation[]

  @@index([hotelId, status])
  @@index([checkInDate, checkOutDate])
  @@index([primaryGuestId])
  @@index([roomId])
}

model BookingGuest {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id])
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([bookingId, guestId])
  @@index([bookingId])
  @@index([guestId])
}

model Reservation {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inquiryDate   DateTime @default(now())
  tentativeDate DateTime?
  confirmedDate DateTime?
  expiryDate    DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([bookingId])
}

// -------------------------------------------------------------
// 4. FOLIO, BILLING, SERVICES & GST
// -------------------------------------------------------------

model Folio {
  id           String   @id @default(cuid())
  folioNumber  String   @unique // e.g. FOL-2026-0001
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id])
  bookingId    String   @unique
  booking      Booking  @relation(fields: [bookingId], references: [id])
  guestId      String
  guest        Guest    @relation(fields: [guestId], references: [id])
  status       String   @default("Open") // Open, Closed, Settled

  totalDebit   Decimal  @default(0.00) @db.Decimal(12, 2)
  totalCredit  Decimal  @default(0.00) @db.Decimal(12, 2)
  balanceDue   Decimal  @default(0.00) @db.Decimal(12, 2)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items           FolioItem[]
  payments        Payment[]
  gstTransactions GSTTransaction[]

  @@index([hotelId])
  @@index([guestId])
  @@index([status])
}

model FolioItem {
  id          String        @id @default(cuid())
  folioId     String
  folio       Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)
  itemType    FolioItemType
  description String
  quantity    Int           @default(1)
  unitPrice   Decimal       @db.Decimal(12, 2)
  totalPrice  Decimal       @db.Decimal(12, 2)
  sacCode     String        @default("996311")
  gstRate     Decimal       @db.Decimal(5, 4) // e.g. 0.1200 or 0.1800
  gstAmount   Decimal       @default(0.00) @db.Decimal(12, 2)
  isVoided    Boolean       @default(false)
  voidReason  String?
  splitTarget String?       // Corporate or Personal
  postedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  gstTransaction GSTTransaction?

  @@index([folioId])
  @@index([sacCode])
}

model Payment {
  id                 String        @id @default(cuid())
  paymentNumber      String        @unique // e.g. PAY-2026-0001
  folioId            String
  folio              Folio         @relation(fields: [folioId], references: [id])
  guestId            String?
  guest              Guest?        @relation(fields: [guestId], references: [id])
  amount             Decimal       @db.Decimal(12, 2)
  method             PaymentMethod
  status             PaymentStatus @default(Captured)
  transactionRef     String?
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
panNumber          String? // Mandated for cash > 50,000
  isLoyaltyRedemption Boolean     @default(false) // Posted by the loyalty redemption flow, not by a gateway
  loyaltyTransactionId String? // The LoyaltyTransaction this credit belongs to (reverse-reversal link)
  refundedAmount     Decimal       @default(0.00) @db.Decimal(12, 2) // Drives proportional loyalty reversal on partial refunds
  notes              String?
  receivedAt         DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([folioId])
  @@index([guestId])
  @@index([razorpayOrderId])
  @@index([method])
  @@index([status])
  @@index([isLoyaltyRedemption])
}

model GSTTransaction {
  id            String    @id @default(cuid())
  folioId       String
  folio         Folio     @relation(fields: [folioId], references: [id])
  folioItemId   String?   @unique
  folioItem     FolioItem? @relation(fields: [folioItemId], references: [id])
  taxableAmount Decimal   @db.Decimal(12, 2)
  cgstRate      Decimal   @default(0.00) @db.Decimal(5, 4)
  cgstAmount    Decimal   @default(0.00) @db.Decimal(12, 2)
  sgstRate      Decimal   @default(0.00) @db.Decimal(5, 4)
  sgstAmount    Decimal   @default(0.00) @db.Decimal(12, 2)
  igstRate      Decimal   @default(0.00) @db.Decimal(5, 4)
  igstAmount    Decimal   @default(0.00) @db.Decimal(12, 2)
  totalTax      Decimal   @db.Decimal(12, 2)
  sacCode       String
  placeOfSupply String // 2-digit Indian State code
  createdAt     DateTime  @default(now())

  @@index([folioId])
  @@index([sacCode])
  @@index([placeOfSupply])
}

model Service {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code        String
  name        String
  category    String // Dining, Laundry, Spa, Banquet, Transport
  sacCode     String
  basePrice   Decimal  @db.Decimal(12, 2)
  gstRate     Decimal  @default(0.18) @db.Decimal(5, 4)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hotelId, code])
  @@index([hotelId])
}

// -------------------------------------------------------------
// 5. CRM, LEADS, LOYALTY & AUDIT
// -------------------------------------------------------------

model CRMLead {
  id                 String     @id @default(cuid())
  hotelId            String
  hotel              Hotel      @relation(fields: [hotelId], references: [id])
  guestId            String?
  guest              Guest?     @relation(fields: [guestId], references: [id])
  guestName          String
  mobile             String
  email              String?
  source             String     @default("Website")
  requirement        String?
  expectedCheckIn    DateTime?
  expectedCheckOut   DateTime?
  guestCount         Int?       @default(2)
  status             LeadStatus @default(New)
  notes              String?
  convertedBookingId String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([hotelId, status])
  @@index([mobile])
}

model LoyaltyAccount {
  id                 String      @id @default(cuid())
  guestId            String      @unique
  guest              Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  hotelId            String?
  hotel              Hotel?      @relation(fields: [hotelId], references: [id])
  tier               LoyaltyTier @default(Bronze)
  availablePoints    Int         @default(0) // Cached projection of SUM(transactions.points) — never written without a LoyaltyTransaction
  lifetimePoints     Int         @default(0)
  redeemedPoints     Int         @default(0)
  expiredPoints      Int         @default(0)
  lifetimeSpendInr   Decimal     @default(0.00) @db.Decimal(14, 2) // Cumulative qualifying spend drives the tier
  pointsExpiringQty  Int         @default(0)
  expiresAt          DateTime? // Next expiry date of the oldest live lot
  tierChangedAt      DateTime?
  lastEarnedAt       DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  transactions    LoyaltyTransaction[]

  @@index([hotelId])
  @@index([tier])
}

/// Admin-configurable loyalty program settings (one row per property).
model LoyaltySetting {
  id                            String          @id @default(cuid())
  hotelId                       String          @unique
  hotel                         Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  basePointsPerRupee            Decimal         @default(0.05) @db.Decimal(7, 4)
  baseRedemptionValuePerPoint   Decimal         @default(0.50) @db.Decimal(7, 4)
  minPointsForRedemption        Int             @default(500)
  maxRedemptionPercentPerFolio  Decimal         @default(0.50) @db.Decimal(5, 4)
  isEarningEnabled              Boolean         @default(true)
  isRedemptionEnabled           Boolean         @default(true)
  earnOnPaymentCapture          Boolean         @default(true)
  eligibleItemTypes             String          @default("[\"Room\",\"Restaurant\",\"InRoomDining\",\"Food\",\"Spa\",\"Laundry\",\"Banquet\"]")
  eligibleSacCodes              String          @default("[]")
  isExpiryEnabled               Boolean         @default(true)
  expiryMonths                  Int             @default(24)
  expiryGracePeriodMonths       Int             @default(3)
  expiryBasis                   LoyaltyExpiryBasis @default(EarnTransactionDate)
  lastExpiryRunAt               DateTime?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt

  tiers LoyaltyTierRule[]

  @@index([hotelId])
}

/// Per-tier thresholds and earn/redeem economics.
model LoyaltyTierRule {
  id                           String      @id @default(cuid())
  hotelId                      String
  hotel                        Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tier                         LoyaltyTier
  thresholdLifetimeSpendInr    Decimal     @default(0.00) @db.Decimal(14, 2)
  pointsPerRupee               Decimal     @default(0.05) @db.Decimal(7, 4)
  redemptionValuePerPoint      Decimal     @default(0.50) @db.Decimal(7, 4)
  monthlyBonusPoints           Int         @default(0)
  minPointsForRedemption       Int         @default(500)
  maxRedemptionPercentPerFolio Decimal     @default(0.50) @db.Decimal(5, 4)
  isActive                     Boolean     @default(true)
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt

  setting LoyaltySetting? @relation(fields: [hotelId], references: [hotelId], map: "LoyaltyTierRule_setting_hotelId_fkey")

  @@unique([hotelId, tier])
  @@index([hotelId])
}

/// APPEND-ONLY LEDGER. Rows are never updated or deleted — corrections are
/// expressed as a new Reversal/Adjustment row referencing the original.
model LoyaltyTransaction {
  id                       String                 @id @default(cuid())
  loyaltyAccountId         String
  loyaltyAccount           LoyaltyAccount         @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  hotelId                  String?
  type                     LoyaltyTransactionType
  points                   Int // Signed delta: credits positive, debits negative
  balanceAfter             Int // Running availablePoints immediately after this row
  reversalOfTransactionId  String? // Unique: a row can be reversed at most once
  reversalOf               LoyaltyTransaction?    @relation("LoyaltyReversal", fields: [reversalOfTransactionId], references: [id])
  reversedBy               LoyaltyTransaction?    @relation("LoyaltyReversal")
  referencePaymentId       String?
  referenceFolioId         String?
  eligibleSpendInr         Decimal?               @db.Decimal(12, 2)
  creditInr                Decimal?               @db.Decimal(12, 2)
  tier                     LoyaltyTier            @default(Bronze)
  description              String?
  notes                    String?
  expiresAt                DateTime?
  createdByUserId          String?
  createdAt                DateTime               @default(now())

  @@unique([reversalOfTransactionId])
  @@index([loyaltyAccountId])
  @@index([hotelId])
  @@index([type])
  @@index([referenceFolioId])
  @@index([referencePaymentId])
}

model User {
  id        String   @id @default(cuid())
  hotelId   String?
  hotel     Hotel?   @relation(fields: [hotelId], references: [id])
  name      String
  email     String   @unique
  password  String // Argon2 / bcrypt hash
  role      UserRole @default(FrontDesk)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([email])
}

model AuditLog {
  id            String   @id @default(cuid())
  hotelId       String?
  hotel         Hotel?   @relation(fields: [hotelId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  entity        String
  entityId      String
  previousValue String?  @db.Text // JSON
  newValue      String?  @db.Text // JSON
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())

  @@index([hotelId])
  @@index([entity, entityId])
  @@index([action])
  @@index([timestamp])
}
